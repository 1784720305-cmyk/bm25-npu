# Included by IndexSDK's original ascendhost/CMakeLists.txt, after ascendfaiss_host exists.
OPTION(BUILD_ASCEND_BM25 "Compile sparse BM25 into libascendfaiss" OFF)
IF(NOT BUILD_ASCEND_BM25)
    RETURN()
ENDIF()
SET(BM25_VENDOR_DIR "" CACHE PATH "Frozen fused/Merge vendor aliases")
GET_FILENAME_COMPONENT(BM25_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
FIND_PATH(BM25_META_INCLUDE aclnn/acl_meta.h
    PATHS "${ASCEND_TOOLKIT_PATH}/include" "${ASCEND_TOOLKIT_PATH}/include/aclnnop" NO_DEFAULT_PATH)
FIND_LIBRARY(BM25_NNOP_LIBRARY nnopbase PATHS "${ASCEND_TOOLKIT_PATH}/lib64" NO_DEFAULT_PATH)
IF(NOT BM25_META_INCLUDE OR NOT BM25_NNOP_LIBRARY)
    MESSAGE(FATAL_ERROR "BM25 requires real CANN ACLNN headers and libnnopbase")
ENDIF()
SET(BM25_API_INCLUDES "")
FOREACH(BM25_PAIR bm25_fused_score_topk/aclnn_bm25_fused_score_top_k.h bm25_topk_merge/aclnn_bm25_top_k_merge.h)
    STRING(REPLACE "/" "/op_api/include/" BM25_HEADER "${BM25_PAIR}")
    IF(NOT EXISTS "${BM25_VENDOR_DIR}/${BM25_HEADER}")
        MESSAGE(FATAL_ERROR "Frozen operator API missing: ${BM25_HEADER}")
    ENDIF()
    GET_FILENAME_COMPONENT(BM25_INCLUDE "${BM25_VENDOR_DIR}/${BM25_HEADER}" DIRECTORY)
    LIST(APPEND BM25_API_INCLUDES "${BM25_INCLUDE}")
ENDFOREACH()
SET(BM25_IMPLEMENTATION "")
FOREACH(BM25_FILE runtime.cpp fused_runtime.cpp planned_search.cpp large_search.cpp AscendIndexBm25.cpp)
    LIST(APPEND BM25_IMPLEMENTATION "${BM25_SDK_ROOT}/ascendhost/src/bm25/${BM25_FILE}")
ENDFOREACH()
TARGET_SOURCES(${TARGET_LIBRARY} PRIVATE ${BM25_IMPLEMENTATION})
SET_SOURCE_FILES_PROPERTIES(${BM25_IMPLEMENTATION} PROPERTIES
    COMPILE_OPTIONS "-ffp-contract=off;-fno-fast-math" COMPILE_DEFINITIONS "_GNU_SOURCE")
TARGET_INCLUDE_DIRECTORIES(${TARGET_LIBRARY} PRIVATE "${BM25_SDK_ROOT}" "${BM25_META_INCLUDE}" ${BM25_API_INCLUDES})
TARGET_LINK_LIBRARIES(${TARGET_LIBRARY} ${BM25_NNOP_LIBRARY} ${CMAKE_DL_LIBS})

# Preserve IndexSDK's public header and shared-library layout. Transitive sparse
# data headers keep their existing directories; no CANN header/library is copied.
INSTALL(FILES "${BM25_SDK_ROOT}/ascendhost/include/index/AscendIndexBm25.h"
    DESTINATION include/faiss/ascend)
INSTALL(FILES "${BM25_SDK_ROOT}/common/ErrorCode.h" DESTINATION include/faiss/ascend/common)
INSTALL(DIRECTORY "${BM25_SDK_ROOT}/common/bm25" DESTINATION include/faiss/ascend/common
    FILES_MATCHING PATTERN "*.h")

OPTION(BM25_BUILD_INTEGRATION_TESTS "Build BM25 integration checks" ON)
IF(BM25_BUILD_INTEGRATION_TESTS)
    INCLUDE(CTest)
    ENABLE_TESTING()
    FIND_PACKAGE(OpenMP REQUIRED COMPONENTS CXX)
    ADD_LIBRARY(bm25_common INTERFACE)
    TARGET_INCLUDE_DIRECTORIES(bm25_common INTERFACE "${BM25_SDK_ROOT}")
    TARGET_COMPILE_OPTIONS(bm25_common INTERFACE -ffp-contract=off -fno-fast-math)
    SET(BM25_INDEXSDK_SOURCE "${BM25_SDK_ROOT}/../../..")
    SET(BM25_INDEXSDK_INCLUDE "${BM25_SDK_ROOT}")
    SET(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
    ADD_SUBDIRECTORY("${BM25_SDK_ROOT}/ut/cases/bm25" "${CMAKE_BINARY_DIR}/bm25_ut")
    ADD_EXECUTABLE(bm25_sdk_shared_check "${BM25_SDK_ROOT}/test/ascendhost/bm25/sdk_shared_check.cpp")
    ADD_EXECUTABLE(bm25_sdk_benchmark "${BM25_SDK_ROOT}/test/ascendhost/bm25/sdk_benchmark.cpp")
    FOREACH(BM25_TEST bm25_sdk_shared_check bm25_sdk_benchmark)
        TARGET_INCLUDE_DIRECTORIES(${BM25_TEST} PRIVATE "${BM25_SDK_ROOT}" "${BM25_SDK_ROOT}/common"
            "${ASCEND_TOOLKIT_PATH}/include" "${BM25_META_INCLUDE}")
        TARGET_LINK_LIBRARIES(${BM25_TEST} ${TARGET_LIBRARY} ${CMAKE_DL_LIBS})
        TARGET_COMPILE_OPTIONS(${BM25_TEST} PRIVATE -ffp-contract=off -fno-fast-math)
    ENDFOREACH()
ENDIF()
